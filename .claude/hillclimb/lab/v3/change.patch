+    ctx.clip();
+    ctx.font = fontFor(tf);
+    ctx.textBaseline = "alphabetic";
+
+    // title
+    if (M.title) {
+      ctx.textAlign = "left";
+      ctx.fillStyle = COL.mapMuted;
