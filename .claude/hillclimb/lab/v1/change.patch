+/* ---------- first-screen budget ---------- */
+/* The numbers a mode teaches with (key tiles, the nine windows, the compare table)
+   and the controls must sit on the first screen, so the range gives up height
+   before they fall below the fold. --reserve is what the range leaves free. */
+body[data-mode="w"]{--reserve:32rem;}
+body[data-mode="c"]{--reserve:32rem;}
+@media (max-width:900px){
+  .wrap{display:flex;flex-direction:column;}
+  .wrap > main{order:1;}
+  .wrap > footer{order:3;}
+  /* The tool switcher moves under the lab so the lab starts higher on the screen. */
+  .wrap > nav.tabs{order:2;margin:var(--gap) 0 0;}
+  body[data-mode="w"] .key-tiles,body[data-mode="c"] .key-tiles{display:none;}
+  .windows,.compare{margin-top:.8rem;}
+}
+@media (min-width:560px) and (max-width:900px){
